{
  "identifier": "default",
  "description": "Default capabilities for the app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "notification:default"
  ]
}
