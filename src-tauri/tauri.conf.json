{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BilbliCopy",
  "version": "1.2.0",
  "identifier": "com.bilbli-copy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BilbliCopy",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src * data: blob:; media-src 'self' blob: data:; script-src 'self' https://*.geetest.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost biliproxy: http://biliproxy.localhost https://*.geetest.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQkY0NjM2MUMxQzg1ODEKUldTQmhSd2NOa2EvWVdVZ0dnUTVFVC8zeTdtUTVKVDZZSmJaRnAzSFZJa3ZMYVBYcHFrcjlZYWcK",
      "endpoints": [
        "https://github.com/mkktop/bilbili_copy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/ffmpeg.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": null
    }
  }
}
